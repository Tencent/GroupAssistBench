# Never commit a real .env file.
OPENAI_API_KEY=
# Leave empty for the official endpoint.
OPENAI_BASE_URL=
# GPT-5.5 for all three roles by default.
# MODEL_CHEAP only drives the first-pass request check in P2; borderline cases
# are re-judged by MODEL_MAIN either way.
MODEL_MAIN=gpt-5.5
MODEL_CHEAP=gpt-5.5
MODEL_PROFILE=gpt-5.5
REASONING_EFFORT=minimal
FORCE_JSON=1
CTX_FULL=1
CTX_MAX_TOKENS=120000
PACE_TPM=25000

# Final pipeline defaults
D2_MIN_UNITS=2
D3_R7_REQUIRE=1
D3_V2=1
D3_V2_FORMS=service,trace
